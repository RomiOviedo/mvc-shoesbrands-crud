@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center" style="color: darkblue">
    <h1 class="display-4 ">Welcome</h1>
    <p class="lead mt-3">
        Encontrá tu próximo par favorito.
    </p>

    <p class="text-muted">
        Explorá nuestro catálogo de calzado y descubrí distintas marcas.
    </p>

    <div class="mt-4">
        <a asp-controller="Shoe"
           asp-action="Index"
           class="btn btn-primary btn-lg me-2">
            <i class="bi bi-bag"></i> Ver calzado
        </a>

        <a asp-controller="Brand"
           asp-action="Index"
           class="btn btn-outline-secondary btn-lg">
            Ver marcas
        </a>
    </div>
</div>

<hr class="my-4" />
<div id="carruselZapatillas" class="carousel slide">
    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="~/imagenes/zapatillas/zapatilla-01.jpg"
                 class="imagen-zapatilla"
                 alt="Zapatilla deportiva 1">
        </div>

        <div class="carousel-item">
            <img src="~/imagenes/zapatillas/zapatilla-02.jpg"
                 class="imagen-zapatilla"
                 alt="Zapatilla deportiva 2">
        </div>

        <div class="carousel-item">
            <img src="~/imagenes/zapatillas/zapatilla-03.jpg"
                 class="imagen-zapatilla"
                 alt="Zapatilla deportiva 3">
        </div>

        <div class="carousel-item">
            <img src="~/imagenes/zapatillas/zapatilla-04.jpg"
                 class="imagen-zapatilla"
                 alt="Zapatilla deportiva 4">
        </div>
        <div class="carousel-item">
            <img src="~/imagenes/zapatillas/zapatilla-05.jpg"
                 class="imagen-zapatilla"
                 alt="Zapatilla deportiva 5">
        </div>
        <div class="carousel-item">
            <img src="~/imagenes/zapatillas/zapatilla-06.jpg"
                 class="imagen-zapatilla"
                 alt="Zapatilla deportiva 6">
        </div>

    </div>
    <button class="carousel-control-prev bg-dark"
            type="button"
            data-bs-target="#carruselZapatillas"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon"
              aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>

    <button class="carousel-control-next bg-dark"
            type="button"
            data-bs-target="#carruselZapatillas"
            data-bs-slide="next">
        <span class="carousel-control-next-icon"
              aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
    
</div>



<div class="row text-center g-4 py-3">
    <div class="col-md-4">
        <i class="bi bi-shoe-prints fs-1 text-primary"></i>
        <h3 class="h5 mt-3">Variedad de calzado</h3>
        <p>Explorá los productos disponibles.</p>
    </div>

    <div class="col-md-4">
        <i class="bi bi-tags fs-1 text-primary"></i>
        <h3 class="h5 mt-3">Distintas marcas</h3>
        <p>Conocé las marcas de nuestro catálogo.</p>
    </div>

    <div class="col-md-4">
        <i class="bi bi-cart3 fs-1 text-primary"></i>
        <h3 class="h5 mt-3">Tu carrito</h3>
        <p>Revisá los productos que elegiste.</p>
    </div>
</div>
